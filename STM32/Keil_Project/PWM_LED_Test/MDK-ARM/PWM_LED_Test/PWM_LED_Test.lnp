--cpu Cortex-M3
"pwm_led_test\startup_stm32f103xe.o"
"pwm_led_test\main.o"
"pwm_led_test\stm32f1xx_it.o"
"pwm_led_test\stm32f1xx_hal_msp.o"
"pwm_led_test\stm32f1xx_hal_gpio_ex.o"
"pwm_led_test\stm32f1xx_hal_tim.o"
"pwm_led_test\stm32f1xx_hal_tim_ex.o"
"pwm_led_test\stm32f1xx_hal.o"
"pwm_led_test\stm32f1xx_hal_rcc.o"
"pwm_led_test\stm32f1xx_hal_rcc_ex.o"
"pwm_led_test\stm32f1xx_hal_gpio.o"
"pwm_led_test\stm32f1xx_hal_dma.o"
"pwm_led_test\stm32f1xx_hal_cortex.o"
"pwm_led_test\stm32f1xx_hal_pwr.o"
"pwm_led_test\stm32f1xx_hal_flash.o"
"pwm_led_test\stm32f1xx_hal_flash_ex.o"
"pwm_led_test\stm32f1xx_hal_exti.o"
"pwm_led_test\stm32f1xx_hal_uart.o"
"pwm_led_test\system_stm32f1xx.o"
--strict --scatter "PWM_LED_Test\PWM_LED_Test.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "PWM_LED_Test.map" -o PWM_LED_Test\PWM_LED_Test.axf