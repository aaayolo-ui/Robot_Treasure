+static void Route_ObserveIdentity(uint32_t now,uint32_t elapsed_ms)
+{
+  RouteGraySample_t sample;ThiefLocYaw_t yaw;int32_t moved;
+  Route_ResetSample(&sample);front_state=Route_ReadFront(&sample);rear_state=Route_ReadRear(&sample);
+  Thief_LocalYaw(&yaw);Chassis_UpdateFeedback(elapsed_ms);
