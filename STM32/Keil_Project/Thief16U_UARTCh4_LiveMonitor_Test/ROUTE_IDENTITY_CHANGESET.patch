+static uint8_t NextObservedJunction(uint16_t from,uint8_t heading,uint16_t *next)
+{
+  uint16_t hops,node=from;
+  for(hops=0U;hops<MAP_ROUTE_NODE_COUNT;hops++) {
+    if(!ThiefMapPlanner_HasRoad(node,heading,&node,NULL))return 0U;
+    /* N005 is a treasure marker on a straight road, not a gray junction. */
+    if(ThiefMapPlanner_Node(node)->kind!=0U){*next=node;return 1U;}
+  }
+  return 0U;
+}
