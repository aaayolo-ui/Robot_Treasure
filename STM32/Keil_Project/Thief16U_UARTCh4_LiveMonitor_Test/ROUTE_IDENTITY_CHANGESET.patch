+    if(!map_gray_missing_active){map_gray_missing_active=1U;map_gray_missing_tick=now;}
+    if((uint32_t)(now-map_gray_missing_tick)>=2000U){Route_StopFault("GRAY_BOTH_NO_LINE");return;}
+  } else map_gray_missing_active=0U;
