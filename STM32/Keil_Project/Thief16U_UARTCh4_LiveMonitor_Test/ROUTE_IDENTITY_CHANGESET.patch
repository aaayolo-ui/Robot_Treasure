+  uint16_t node,next;uint8_t hops;
+  MapRouteStep_t observed;
+  if(!c || !s || s->heading>3U)return 0U;
+  memset(c,0,sizeof(*c));c->heading=s->heading;c->branch_raw=raw;
+  observed=*s;node=s->to_node;
+  for(hops=0U;hops<4U;hops++) {
+    const MapRouteNode_t *n=ThiefMapPlanner_Node(node);
+    if(!n)break;
+    observed.to_node=node;observed.target_kind=n->kind;
+    if(ThiefLocalization_GrayMatchesStep(&observed,raw))c->nodes[c->count++]=node;
+    if(!NextObservedJunction(node,s->heading,&next) || next==node)break;
+    node=next;
+  }
+  return c->count;
+}
+
+uint16_t ThiefLocalization_CandidatesObserve(ThiefLocCandidates *c,
+    uint16_t leading,uint16_t trailing,int32_t moved)
+{
+  uint8_t i,count=0U,straight;
+  if(!c || !c->count || c->resolved)return 0U;
+  c->new_branch=0U;
+  if(c->armed && (leading&0x00F0U) &&
+      ((leading&0x0C00U)==0x0C00U || (leading&3U)==3U)) {
+    uint16_t nodes[4];MapRouteStep_t s;
+    if(++c->branch_frames<3U)return 0U;
+    memset(&s,0,sizeof(s));s.heading=c->heading;
+    for(i=0U;i<c->count;i++) {
+      uint16_t node;
+      if(NextObservedJunction(c->nodes[i],c->heading,&node)) {
+        s.to_node=node;s.target_kind=ThiefMapPlanner_Node(node)->kind;
+        if(ThiefLocalization_GrayMatchesStep(&s,leading))nodes[count++]=node;
+      }
+    }
+    if(count) {
+      for(i=0U;i<count;i++)c->nodes[i]=nodes[i];
+      c->count=count;c->branch_raw=leading;c->new_branch=1U;c->armed=0U;
+      c->straight_frames=0U;c->gap_frames=0U;
+      if(count==1U){c->resolved=1U;return c->nodes[0];}
+    }
+    c->branch_frames=0U;return 0U;
+  }
+  c->branch_frames=0U;
+  if(moved<30L)return 0U;
+  /* A real line continuing beyond the branch distinguishes a T from a
+   * corner. Absence requires trailing-board corroboration, not one white read. */
+  if((leading&0x00F0U) && !(leading&0x0C03U)) {
+    if(c->straight_frames<3U)c->straight_frames++;
+    c->gap_frames=0U;
+  } else if(!leading && (trailing&0x00F0U)) {
+    if(c->gap_frames<3U)c->gap_frames++;
+    c->straight_frames=0U;
+  } else {c->straight_frames=0U;c->gap_frames=0U;}
+  if(c->straight_frames<3U && c->gap_frames<3U)return 0U;
+  straight=(uint8_t)(c->straight_frames>=3U);
+  for(i=0U;i<c->count;i++) {
+    if((uint8_t)ThiefMapPlanner_HasRoad(c->nodes[i],c->heading,NULL,NULL)==straight)
+      c->nodes[count++]=c->nodes[i];
+  }
+  /* Inconsistent observations do not conjure a node or erase hypotheses. */
+  if(count)c->count=count;
+  if(count==1U) {c->resolved=1U;return c->nodes[0];}
+  if(count>1U && straight)c->armed=1U;
+  c->straight_frames=0U;c->gap_frames=0U;return 0U;
+}
+
+uint8_t ThiefLocalization_ConfirmCandidate(ThiefLocalization_t *l,
+    const ThiefLocCandidates *c,const ThiefLocYaw_t *y,uint32_t now)
+{
+  if(!l || !c || !l->initialized || l->error!=THIEF_LOC_OK ||
+      !c->resolved || c->count!=1U || c->heading!=l->step.heading ||
+      l->phase!=THIEF_LOC_ON_LEG || !ThiefMapPlanner_Node(c->nodes[0]) ||
+      !Fresh(l,y,now) || !HeadingOK(l,l->body_heading,y,l->yaw_cw_sign))return 0U;
+  if(Abs(l->heading_error_x100)>1000L)return 0U;
+  l->confirmed_node=c->nodes[0];l->phase=THIEF_LOC_AT_NODE;
+  l->gray_raw12=c->branch_raw;l->arrival_yaw_x100=y->yaw_x100;l->confirmations++;
+  ThiefMapPlanner_PoseAtNode(l->confirmed_node,l->body_heading,&l->pose);
+  l->pose.drive_mode=l->step.drive_mode;l->pose.travel_heading=c->heading;
+  return 1U;
 }
