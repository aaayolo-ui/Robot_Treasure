+/* Read-only turn observation: do not enable the old cardinal threat gate
+ * while the chassis rotates, and never change a turn from a UART callback. */
+static void Thief_RecordPursuit(uint8_t channel,uint16_t distance,uint8_t confidence,uint32_t tick)
+{
+  const MapRouteStep_t *s=MapRouteNavigator_Current(&map_nav),*last;
+  ThiefPursuitPose pose;ThiefLocYaw_t yaw;
+  uint32_t now=SystemTime_GetMs();
+  if(!route_active || !thief_treasure_passed || !s ||
+      map_nav.step+2U<map_nav.route->count ||
+      (uint32_t)(now-tick)>THIEF_LASER_MOVING_FRAME_MAX_MS ||
+      (int32_t)(tick-thief_laser_pose_since)<0L)return;
+  if(route_state!=ROUTE_STATE_TURN_STOP && route_state!=ROUTE_STATE_TURN_LEFT &&
+      route_state!=ROUTE_STATE_TURN_RIGHT && route_state!=ROUTE_STATE_AFTER_TURN_FORWARD &&
+      route_state!=ROUTE_STATE_FOLLOW && route_state!=ROUTE_STATE_LEAVE_START)return;
+  Thief_LocalYaw(&yaw);
+  if(!yaw.valid || (uint32_t)(now-yaw.stamp_ms)>50U ||
+      (thief_localization.yaw_cw_sign!=1 && thief_localization.yaw_cw_sign!=-1))return;
+  if(map_nav.arrived || departure_turn) {
+    const MapRouteNode_t *node=ThiefMapPlanner_Node(departure_turn?map_nav.route->start_node:s->to_node);
+    pose.x=(int16_t)(node->x_half*150);pose.y=(int16_t)(node->y_half*150);
+  } else {
+    if(!thief_pose.valid)return;
+    pose.x=thief_pose.x_mm;pose.y=thief_pose.y_mm;
+  }
+  last=&map_nav.steps[map_nav.route->count-1U];pose.travel_heading=last->heading;
+  pose.body_cw_x100=thief_localization.origin_heading*9000L+
+      ((int32_t)yaw.yaw_x100-thief_localization.origin_yaw_x100)*thief_localization.yaw_cw_sign;
+  ThiefPursuit_Observe(&pursuit,channel,distance,confidence,&pose,tick);
+}
+static void Thief_ExtendPursuedHide(uint32_t now)
+{
+  const MapRouteStep_t *s=MapRouteNavigator_Current(&map_nav),*last;
+  uint16_t old_goal,count;uint8_t mask,body,heading;
+  /* Search only after rotation/line acquisition, while normally following.
+   * At least the final leg remains: the old hide STOP has not begun. */
+  if(!route_active || !s || map_nav.arrived || departure_turn || intercept_pending ||
+      replan_after_leg || (route_state!=ROUTE_STATE_FOLLOW && route_state!=ROUTE_STATE_LEAVE_START) ||
+      map_nav.step+2U<map_nav.route->count)return;
+  old_goal=thief_plan.goal_node;
+  if(pursuit_attempt_goal==old_goal || !ThiefIntercept_HideAxis(old_goal))return;
+  count=thief_plan.route.count;last=&thief_plan.steps[count-1U];
+  mask=ThiefPursuit_GoalMask(&pursuit,last,now);if(!mask)return;
+  pursuit_attempt_goal=old_goal;
+  body=(uint8_t)((last->heading+2U*last->drive_mode)%4U);
+  for(heading=0U;heading<4U;heading++)if(mask&(1U<<heading))break;
+  ThiefThreatModel_Record(heading,pursuit.x,pursuit.y,pursuit.stamp);
+  if(!ThiefMapPlanner_PlanEscape(old_goal,body,mask,thief_current_node,now,&pursuit_tail))return;
+  if(route_trail.enabled && !route_trail.returning &&
+      route_trail.count+count-map_nav.step+pursuit_tail.route.count>THIEF_TRAIL_CAPACITY)return;
+  if(!ThiefPursuit_Append(&thief_plan,&pursuit_tail))return;
+  UartDebug_Printf("PURSUIT_PASS AT=N%03u NEXT=N%03u GOAL=N%03u MASK=%u AGE=%lu\r\n",
+      (unsigned)old_goal,(unsigned)thief_plan.steps[count].to_node,(unsigned)thief_plan.goal_node,
+      (unsigned)mask,(unsigned long)(now-pursuit.stamp));
+}
