+static uint8_t Route_CompactLine(uint16_t raw)
+{
+  /* A compact inner-board group may be a line. An isolated P1/P12 or a
+   * disconnected word-like pattern must not authorize forward recovery. */
+  if(!(raw&0x03FCU) || (raw&0x0C03U))return 0U;
+  while(!(raw&1U))raw>>=1U;
+  return (uint8_t)(raw<=15U && !(raw&(uint16_t)(raw+1U)));
+}
+
+static void Route_AcquireTurnLine(uint32_t now,uint32_t elapsed_ms)
+{
+  RouteGraySample_t sample;ThiefLocYaw_t yaw;
+  int8_t quarter=turn_target_state==ROUTE_STATE_TURN_LEFT?-1:1;
+  int16_t delta,turn;int32_t progress,error,target,heading_difference;
+  uint8_t paired;
+  Route_ResetSample(&sample);front_state=Route_ReadFront(&sample);
+  rear_state=Route_ReadRear(&sample);Thief_LocalYaw(&yaw);
+  if(front_state==ROUTE_GRAY_I2C_ERROR || rear_state==ROUTE_GRAY_I2C_ERROR) {
+    Route_BrakeControl();turn_line_count=0U;
+    if(gray_missing_active!=2U){gray_missing_active=2U;gray_missing_tick=now;}
+    if((uint32_t)(now-gray_missing_tick)>=ROUTE_FRONT_RECOVERY_MS)Route_StopFault("GRAY_I2C");
+    return;
+  }
+  if(!sample.front_raw12 && !sample.rear_raw12) {
+    if(gray_missing_active!=1U){gray_missing_active=1U;gray_missing_tick=now;}
+    if((uint32_t)(now-gray_missing_tick)>=2000U){Route_StopFault("GRAY_BOTH_NO_LINE");return;}
+  } else gray_missing_active=0U;
+  delta=Route_TurnAngleDeltaX100(TravelFrame_Yaw(yaw.yaw_x100),turn_start_angle_x100);
+  progress=(int32_t)delta*thief_localization.yaw_cw_sign*quarter;
+  heading_difference=(int32_t)sample.front_error_x100-sample.rear_error_x100;
+  /* Confirm compatible line traces, not an artificial zero lateral error.
+   * The unchanged PID must still correct a real, consistently offset line. */
+  paired=(uint8_t)(progress>=8000L && progress<=10000L &&
+      front_state==ROUTE_GRAY_VALID && rear_state==ROUTE_GRAY_VALID &&
+      Route_CompactLine(sample.front_raw12) && Route_CompactLine(sample.rear_raw12) &&
+      heading_difference>=-200L && heading_difference<=200L);
+  if(paired){if(turn_line_count<3U)turn_line_count++;}else turn_line_count=0U;
+  if(turn_line_count>=3U) {
+    UartDebug_Printf("TURN_LINE_READY DELTA=%ld RAW=%03X,%03X MODE=%u\r\n",
+        (long)progress,(unsigned)sample.front_raw12,(unsigned)sample.rear_raw12,
+        (unsigned)TravelFrame_IsReverse());
+    Route_EnterFollow(now,1U,leave_target_rpm_x10,1U);
+    (void)Route_RunFollow(&sample,elapsed_ms);return;
+  }
+  /* Complete the turn without driving off the junction. If the nominal
+   * 90-degree exit has no paired line, sweep locally from 80 to 100 degrees.
+   * No global map-heading veto, blind translation or timed-position success. */
+  target=9000L+(int32_t)turn_line_scan*1000L;
+  error=progress-target;
+  if(!paired && error>= -300L && error<=300L) {
+    turn_line_scan=turn_line_scan==1?-1:1;
+    target=9000L+(int32_t)turn_line_scan*1000L;error=progress-target;
+  }
+  turn=RoadHeading_Correction((int16_t)(error*quarter),300);
+  if(!ChassisSpeedControl_IsEnabled())Route_ResetControl(1U);
+  TravelFrame_SetWheelTargets(turn,-turn,turn,-turn);
+  ChassisSpeedControl_Update(elapsed_ms);
+  if(ChassisSpeedControl_HasStall()){Route_StopFault("STALL");return;}
+  if((uint32_t)(now-gray_log_tick)>=200U) {
+    gray_log_tick=now;
+    UartDebug_Printf("TURN_LINE_WAIT DELTA=%ld RAW=%03X,%03X COUNT=%u\r\n",
+        (long)progress,(unsigned)sample.front_raw12,(unsigned)sample.rear_raw12,
+        (unsigned)turn_line_count);
   }
 }
 
