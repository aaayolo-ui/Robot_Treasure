+/* First treasure traverse only: real trailing stripe supports a short coin gap.
+ * Keep actual leading RAW unchanged and never commit a node in this helper. */
+static uint8_t Route_TreasureRearBridge(RouteGraySample_t *sample,uint32_t dt)
+{
+  const MapRouteStep_t *step=MapRouteNavigator_Current(&map_nav);
+  int32_t progress,turn;
+  if(front_state!=ROUTE_GRAY_NO_LINE || departure_turn || map_nav.arrived ||
+      !step || map_nav.route->id!=1600U || step->from_node!=6U ||
+      step->to_node!=4U || step->heading!=3U || TravelFrame_IsReverse())return 0U;
+  rear_state=Route_ReadRear(sample);
+  if(rear_state!=ROUTE_GRAY_VALID || !ThiefRouteTrail_TrackLine(sample->rear_raw12))return 0U;
+  progress=Route_LegProgress();
+  if(!treasure_rear_bridge) {
+    treasure_rear_bridge=1U;treasure_rear_start_mm=progress;
+    UartDebug_Printf("TREASURE_REAR_BRIDGE MM=%ld RAW=%03X,%03X\r\n",
+        (long)progress,(unsigned)sample->front_raw12,(unsigned)sample->rear_raw12);
+  }
+  if(progress-treasure_rear_start_mm>=50L || progress<treasure_rear_start_mm)return 0U;
+  if(dt<LINE_FOLLOW_PID_CONTROL_PERIOD_MS)return 1U;
+  turn=sample->rear_error_x100;
+  if(turn>200L)turn=200L;else if(turn< -200L)turn=-200L;
+  TravelFrame_SetWheelTargets(500L+turn,500L-turn,500L+turn,500L-turn);
+  ChassisSpeedControl_Update(dt);
+  if(ChassisSpeedControl_HasStall())Route_StopFault("STALL");
+  return 1U;
+}
