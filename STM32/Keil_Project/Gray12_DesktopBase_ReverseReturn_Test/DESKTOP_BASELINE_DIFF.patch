+/* Reuse a leading-board sample only within this task call. A travel-frame
+ * switch explicitly invalidates it before reading the new leading board. */
+typedef struct
+{
+  RouteGraySample_t sample;
+  RouteGrayState_t state;
+  uint8_t valid;
+} RouteLeadingCache_t;
+
+static RouteGrayState_t Route_ReadLeadingOnce(RouteGraySample_t *sample,
+                                               RouteLeadingCache_t *cache)
+{
+  if (cache->valid == 0U)
+  {
+    Route_ResetSample(&cache->sample);
+    cache->state = Route_ReadFront(&cache->sample);
+    cache->valid = 1U;
+  }
+  *sample = cache->sample;
+  return cache->state;
+}
