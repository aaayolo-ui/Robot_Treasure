+/* At a centered T, the leading board can be past the horizontal stripe on
+ * white while the trailing board remains on the incoming vertical stripe.
+ * This supports the planned turn, but does not invent a gray side port/fix. */
+static void Route_UpdateCenteredT(RouteGraySample_t *sample,uint32_t now)
+{
+  const MapRouteStep_t *step=MapRouteNavigator_Current(&map_nav);
+  const MapRouteNode_t *node;
+  ThiefLocYaw_t yaw;
+  int16_t error;
+  if(!step || !map_nav.arrived || !map_nav.seen_ports ||
+      front_state!=ROUTE_GRAY_NO_LINE)goto missing;
+  node=ThiefMapPlanner_Node(step->to_node);
+  if(node->degree!=3U || ThiefMapPlanner_HasRoad(node->id,step->heading,0,0) ||
+      !ThiefMapPlanner_HasRoad(node->id,(uint8_t)((step->heading+1U)%4U),0,0) ||
+      !ThiefMapPlanner_HasRoad(node->id,(uint8_t)((step->heading+3U)%4U),0,0))goto missing;
+  if(Route_ReadRear(sample)!=ROUTE_GRAY_VALID ||
+      !ThiefRouteTrail_TrackLine(sample->rear_raw12) ||
+      sample->rear_error_x100>150 || sample->rear_error_x100< -150)goto missing;
+  Thief_LocalYaw(&yaw);
+  if(!yaw.valid || (uint32_t)(now-yaw.stamp_ms)>ROUTE_JY61P_STALE_MS ||
+      !thief_localization.yaw_cw_sign)goto missing;
+  error=RoadHeading_AxisError(thief_localization.origin_yaw_x100,
+      thief_localization.origin_heading,route_body_heading,
+      thief_localization.yaw_cw_sign,yaw.yaw_x100);
+  if(error>ROUTE_MAP_GRAY_YAW_TOL_X100 || error< -ROUTE_MAP_GRAY_YAW_TOL_X100)goto missing;
+  if(turn_t_valid_count<2U)turn_t_valid_count++;
+  return;
+missing:
+  turn_t_valid_count=0U;
+}
