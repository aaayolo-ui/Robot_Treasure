+uint8_t UartDebug_TrySendString(const char *text)
+{
+  uint16_t free_bytes;
+  size_t length;
+  const char *cursor;
+  if (text == NULL)
+  {
+    return 0U;
+  }
+  length = 0U;
+  for (cursor = text; *cursor != '\0'; cursor++)
+  {
+    length++;
+  }
+  free_bytes = (uart_debug_tx_tail > uart_debug_tx_head) ?
+      (uint16_t)(uart_debug_tx_tail - uart_debug_tx_head - 1U) :
+      (uint16_t)(UART_DEBUG_TX_BUFFER_SIZE + uart_debug_tx_tail -
+                  uart_debug_tx_head - 1U);
+  if (length > (size_t)free_bytes)
+  {
+    return 0U;
+  }
+  UartDebug_SendString(text);
+  return 1U;
 }
 
