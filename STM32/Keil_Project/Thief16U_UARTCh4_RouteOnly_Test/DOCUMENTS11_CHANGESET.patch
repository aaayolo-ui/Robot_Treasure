+pristine = bytes(u.mem_read(0x20000000, 0x10000))
+loc=symbols['thief_localization'];plan=symbols['thief_plan'];nav=symbols['map_nav']
+po=fields(variables['thief_plan']);steps=plan+po['steps'][0];route=plan+po['route'][0]
+y=0x2000c200
+odom=0
